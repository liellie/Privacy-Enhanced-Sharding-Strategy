

server:
  port: 8080

spring:
  application:
    name: coordinator-1

  cloud:
    nacos:

      username: ${NACOS_USERNAME:nacos}

      password: ${NACOS_PASSWORD}
      discovery:

        server-addr: ${NACOS_SERVER_ADDR:localhost:8848}
        namespace: public
      config:

        server-addr: ${NACOS_SERVER_ADDR:localhost:8848}
        namespace: public

  config:
    import:

      - nacos:shardchain-app.yaml

coordinator:

  coordinator-id: coordinator-1

blockchain:

  private-key: ${BLOCKCHAIN_PRIVATE_KEY:}

  coordinator-address: ${BLOCKCHAIN_COORDINATOR_ADDRESS:0x0000000000000000000000000000000000000000}
